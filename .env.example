DATABASE_URL="mysql://user:password@127.0.0.1:3306/forseti_db"
AUTH_SECRET="change-me-in-production"
SEED_ADMIN_EMAIL="admin@forseti.local"
SEED_ADMIN_PASSWORD="set-a-local-password"

# App access
APP_LOGIN_USER="admin"
APP_LOGIN_PASSWORD="cambia-esto"
APP_SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# Chatbot widget for Forseti
# Minimo para probar: definir solo NEXT_PUBLIC_CHATBOT_WIDGET_BASE_URL
NEXT_PUBLIC_CHATBOT_WIDGET_BASE_URL=""
NEXT_PUBLIC_CHATBOT_TENANT="forseti"
NEXT_PUBLIC_CHATBOT_INSTALLATION="forseti-main"
NEXT_PUBLIC_CHATBOT_HOST_APP="forseti-web"
NEXT_PUBLIC_CHATBOT_APP_NAME="Forseti"
NEXT_PUBLIC_CHATBOT_LAUNCHER_LABEL="Hablar con Forseti"
NEXT_PUBLIC_CHATBOT_PLACEHOLDER="Escribe tu consulta"
NEXT_PUBLIC_CHATBOT_WELCOME_MESSAGE="Hola, soy Forseti. ¿Qué necesitas revisar hoy?"
NEXT_PUBLIC_CHATBOT_TONE="clear"
NEXT_PUBLIC_CHATBOT_OBJECTIVE="support"
NEXT_PUBLIC_CHATBOT_PRIMARY_COLOR="#42c7ed"
NEXT_PUBLIC_CHATBOT_POSITION="right"
NEXT_PUBLIC_CHATBOT_INCLUDE_PATHS="/,/facturacion,/presupuestos,/forseti"
NEXT_PUBLIC_CHATBOT_EXCLUDE_PATHS="/login"

# Password recovery (optional)
RESEND_API_KEY=""
APP_RECOVERY_EMAIL=""
APP_FROM_EMAIL=""

# Google Sheets / Drive service account (preferred for local + production)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""

# Alternatives supported by the app (use only one strategy)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"..."}'
