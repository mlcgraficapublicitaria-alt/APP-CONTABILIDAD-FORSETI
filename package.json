{
  "name": "app-contabilidad-mlcdesign",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "postbuild": "npm run verify:prisma-runtime && npm run prisma:deploy",
    "forseti:operator": "node scripts/run-forseti-operator.mjs",
    "start": "node server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:cierre-trimestral": "vitest run src/lib/cierre-trimestral",
    "test:cierre-trimestral:db": "vitest run tests/integration/quarterly-db.integration.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "verify:prisma-runtime": "prisma generate && node -e \"const fs=require('fs'); const client=fs.readFileSync('src/generated/prisma/internal/class.ts','utf8'); const runtime='node_modules/@prisma/client/runtime/query_compiler_bg.mysql.wasm-base64.mjs'; if (!client.includes('query_compiler_bg.mysql') || !fs.existsSync(runtime)) process.exit(1)\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "chmod +x node_modules/@prisma/engines/schema-engine-* && prisma migrate deploy",
    "db:init": "prisma migrate deploy && npm run db:seed",
    "db:prod": "prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "@sparticuz/chromium": "^143.0.4",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/pdfkit": "^0.17.7",
    "follow-redirects": "^1.16.3",
    "jszip": "^3.10.1",
    "next": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.20.2",
    "prisma": "6.19.3",
    "puppeteer-core": "^24.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tar-fs": "^3.1.3",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "deepmerge-ts": "8.0.0",
    "js-yaml": "5.5.0",
    "mariadb": "3.5.4",
    "minimatch": "11.0.4",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.2.0",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
