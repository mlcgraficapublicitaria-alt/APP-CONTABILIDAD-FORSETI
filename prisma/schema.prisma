generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ADVISOR
  VIEWER
}

enum TaxCaseStatus {
  DRAFT
  IN_REVIEW
  READY
  CLOSED
}

enum DataConfidence {
  CONFIRMED
  ESTIMATED
  PENDING
}

enum DocumentStatus {
  PENDING
  RECEIVED
  REVIEWED
  REJECTED
}

enum ValidationSeverity {
  INFO
  WARNING
  ERROR
}

enum ValidationStatus {
  OPEN
  RESOLVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum QuarterlyClosureStatus {
  DRAFT
  NEEDS_REVIEW
  READY_FOR_REVIEW
}

enum QuarterlyPaymentStatus {
  UNKNOWN
  PENDING_DEFERRAL
  PAID
  DEBITED
}

enum QuarterlyEntryDirection {
  PURCHASE
  SALE
}

enum QuarterlyDocumentType {
  INVOICE
  CREDIT_NOTE
  OTHER
}

enum QuarterlyTaxKind {
  DOMESTIC
  INTRA_EU
  INTRA_EU_GOODS
  INTRA_EU_SERVICES
  REVERSE_CHARGE
  EXEMPT
  NOT_SUBJECT_LOCATION
  OTHER
}

enum QuarterlyReviewStatus {
  OK
  REVIEW
}

enum QuarterlyIssueSeverity {
  INFO
  WARNING
  BLOCKER
}

enum Quarterly349OperationType {
  INTRA_EU_ACQUISITION
  INTRA_EU_SUPPLY
}

enum QuarterlyIssueCode {
  DOMESTIC_PURCHASE_EXCLUDED_FROM_303
  EXEMPT_OPERATION_REVIEW
  DEFERRAL_PENDING
  FORM_LEDGER_MISMATCH
}

enum QuarterlyImportBatchStatus {
  PREVIEW
  CONFIRMED
  FAILED
}

enum QuarterlyImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  IMPORTED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  role         UserRole     @default(ADVISOR)
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  taxCases     TaxCase[]
  documents    Document[]   @relation("DocumentUploader")
  auditEvents  AuditEvent[]
  invoices     Invoice[]    @relation("InvoiceCreatedBy")
}

model TaxCase {
  id                String             @id @default(cuid())
  reference         String             @unique
  title             String
  taxpayerName      String
  taxpayerNif       String?
  fiscalYear        Int
  status            TaxCaseStatus      @default(DRAFT)
  ownerId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  owner             User               @relation(fields: [ownerId], references: [id])
  taxProfile        TaxProfile?
  documents         Document[]
  dataPoints        DataPoint[]
  issues            ValidationIssue[]
  summary           CaseSummary?
  auditEvents       AuditEvent[]
  quarterlyClosures QuarterlyClosure[]
}

model QuarterlyClosure {
  id                       String                    @id @default(cuid())
  taxCaseId                String
  fiscalYear               Int
  quarter                  Int
  status                   QuarterlyClosureStatus    @default(DRAFT)
  declared303ResultCents   BigInt?
  calculated303ResultCents BigInt?
  difference303Cents       BigInt?
  payment303Status         QuarterlyPaymentStatus    @default(UNKNOWN)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  taxCase                  TaxCase                   @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  ledgerEntries            QuarterlyLedgerEntry[]
  operations349            Quarterly349Operation[]
  issues                   QuarterlyIssue[]
  sourceDocuments          QuarterlySourceDocument[]
  importBatches            QuarterlyImportBatch[]

  @@unique([taxCaseId, fiscalYear, quarter])
  @@index([fiscalYear, quarter, status])
}

model QuarterlySourceDocument {
  id            String                 @id @default(cuid())
  closureId     String
  fileName      String
  mimeType      String
  sizeBytes     Int
  sha256        String                 @db.Char(64)
  storageKey    String?
  createdAt     DateTime               @default(now())
  closure       QuarterlyClosure       @relation(fields: [closureId], references: [id], onDelete: Cascade)
  importBatches QuarterlyImportBatch[]

  @@unique([closureId, sha256])
  @@unique([id, closureId])
}

model QuarterlyImportBatch {
  id               String                     @id @default(cuid())
  closureId        String
  sourceDocumentId String
  importerKey      String
  importerVersion  String
  mappingHash      String                     @db.Char(64)
  status           QuarterlyImportBatchStatus @default(PREVIEW)
  mappingJson      Json
  validRowCount    Int                        @default(0)
  invalidRowCount  Int                        @default(0)
  duplicateCount   Int                        @default(0)
  confirmedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  closure          QuarterlyClosure           @relation(fields: [closureId], references: [id], onDelete: Cascade)
  sourceDocument   QuarterlySourceDocument    @relation(fields: [sourceDocumentId, closureId], references: [id, closureId], onDelete: Cascade)
  rows             QuarterlyImportRow[]
  ledgerEntries    QuarterlyLedgerEntry[]

  @@unique([closureId, sourceDocumentId, importerKey, importerVersion, mappingHash], map: "QuarterlyImportBatch_identity_key")
  @@index([closureId, status])
}

model QuarterlyImportRow {
  id             String                   @id @default(cuid())
  importBatchId  String
  sourceRow      Int
  fingerprint    String                   @db.Char(64)
  status         QuarterlyImportRowStatus
  originalJson   Json
  normalizedJson Json?
  errorsJson     Json
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  importBatch    QuarterlyImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  ledgerEntry    QuarterlyLedgerEntry?

  @@unique([importBatchId, sourceRow])
  @@index([importBatchId, fingerprint])
}

model Quarterly349Operation {
  id                      String                    @id @default(cuid())
  closureId               String
  anonymousCounterpartyId String
  operationType           Quarterly349OperationType
  amountCents             BigInt
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  closure                 QuarterlyClosure          @relation(fields: [closureId], references: [id], onDelete: Cascade)

  @@index([closureId, anonymousCounterpartyId])
}

model QuarterlyLedgerEntry {
  id                      String                  @id @default(cuid())
  closureId               String
  anonymousEntryId        String
  anonymousCounterpartyId String?
  operationDate           DateTime
  direction               QuarterlyEntryDirection
  documentType            QuarterlyDocumentType
  taxKind                 QuarterlyTaxKind
  currency                String                  @default("EUR") @db.Char(3)
  baseCents               BigInt
  vatCents                BigInt
  totalCents              BigInt
  vatRateBasisPoints      Int?
  includedIn303           Boolean                 @default(false)
  includedIn349           Boolean                 @default(false)
  reviewStatus            QuarterlyReviewStatus   @default(REVIEW)
  sourceFileId            String?
  sourceSheet             String?
  sourceRow               Int?
  importBatchId           String?
  importRowId             String?                 @unique
  deduplicationKey        String?                 @db.Char(64)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  closure                 QuarterlyClosure        @relation(fields: [closureId], references: [id], onDelete: Cascade)
  importBatch             QuarterlyImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importRow               QuarterlyImportRow?     @relation(fields: [importRowId], references: [id], onDelete: SetNull)

  @@unique([closureId, anonymousEntryId])
  @@unique([closureId, deduplicationKey])
  @@index([closureId, operationDate])
  @@index([closureId, anonymousCounterpartyId])
  @@index([importBatchId])
}

model QuarterlyIssue {
  id                       String                 @id @default(cuid())
  closureId                String
  code                     QuarterlyIssueCode
  severity                 QuarterlyIssueSeverity
  relatedAnonymousEntryIds Json
  amountCents              BigInt?
  baseCents                BigInt?
  vatCents                 BigInt?
  message                  String                 @db.Text
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  closure                  QuarterlyClosure       @relation(fields: [closureId], references: [id], onDelete: Cascade)

  @@index([closureId, code])
  @@index([closureId, severity])
}

model TaxProfile {
  id               String         @id @default(cuid())
  taxCaseId        String         @unique
  residencyStatus  String         @default("pending")
  employmentIncome Boolean        @default(false)
  rentalIncome     Boolean        @default(false)
  investmentIncome Boolean        @default(false)
  selfEmployment   Boolean        @default(false)
  notes            String?
  confidence       DataConfidence @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  taxCase          TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
}

model DocumentRequirement {
  id          String     @id @default(cuid())
  code        String     @unique
  label       String
  description String
  required    Boolean    @default(true)
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  documents   Document[]
}

model Document {
  id            String               @id @default(cuid())
  taxCaseId     String
  requirementId String?
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  status        DocumentStatus       @default(RECEIVED)
  notes         String?
  uploadedById  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  taxCase       TaxCase              @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id])
  uploadedBy    User                 @relation("DocumentUploader", fields: [uploadedById], references: [id])
}

model DataPoint {
  id         String         @id @default(cuid())
  taxCaseId  String
  key        String
  label      String
  value      String?
  source     String?
  confidence DataConfidence @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  taxCase    TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)

  @@unique([taxCaseId, key])
}

model ValidationIssue {
  id          String             @id @default(cuid())
  taxCaseId   String
  code        String
  title       String
  description String
  severity    ValidationSeverity @default(WARNING)
  status      ValidationStatus   @default(OPEN)
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?
  taxCase     TaxCase            @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
}

model CaseSummary {
  id               String         @id @default(cuid())
  taxCaseId        String         @unique
  status           DataConfidence @default(PENDING)
  preliminaryNotes String
  missingCount     Int            @default(0)
  issueCount       Int            @default(0)
  confirmedCount   Int            @default(0)
  estimatedCount   Int            @default(0)
  updatedAt        DateTime       @updatedAt
  taxCase          TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  taxCaseId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())
  taxCase   TaxCase? @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model InvoiceIssuerProfile {
  id            String    @id @default(cuid())
  code          String    @unique
  legalName     String
  taxId         String?
  addressLine1  String?
  addressLine2  String?
  postalCode    String?
  city          String?
  province      String?
  country       String?
  email         String?
  phone         String?
  website       String?
  bankAccount   String?
  invoicePrefix String?
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
}

model InvoiceClient {
  id              String    @id @default(cuid())
  code            String?   @unique
  legalName       String
  taxId           String?
  addressLine1    String?
  addressLine2    String?
  postalCode      String?
  city            String?
  province        String?
  country         String?
  email           String?
  phone           String?
  notes           String?
  nameFontSize    Int       @default(17)
  detailsFontSize Int       @default(14)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]
}

model InvoiceTemplate {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  layoutKey   String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
}

model InvoiceService {
  id          String   @id @default(cuid())
  name        String   @unique
  articleCode String   @default("H")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InvoiceBankAccount {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                 String               @id @default(cuid())
  issuerProfileId    String
  clientId           String
  templateId         String?
  createdById        String?
  status             InvoiceStatus        @default(DRAFT)
  documentName       String
  series             String?
  numberLabel        String               @default("")
  number             Int
  issueDate          DateTime
  articleCode        String?
  serviceDescription String
  subtotalAmount     Decimal              @db.Decimal(10, 2)
  vatRate            Decimal              @db.Decimal(5, 2)
  vatAmount          Decimal              @db.Decimal(10, 2)
  irpfRate           Decimal              @db.Decimal(5, 2)
  irpfAmount         Decimal              @db.Decimal(10, 2)
  totalAmount        Decimal              @db.Decimal(10, 2)
  notes              String?              @db.Text
  renderedHtml       String?              @db.LongText
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  issuerProfile      InvoiceIssuerProfile @relation(fields: [issuerProfileId], references: [id], onDelete: Restrict)
  client             InvoiceClient        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template           InvoiceTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy          User?                @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines              InvoiceLine[]

  @@unique([series, numberLabel])
  @@index([series, number])
  @@index([clientId, issueDate])
  @@index([issuerProfileId, issueDate])
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  sortOrder       Int      @default(0)
  articleCode     String?
  description     String   @db.Text
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2)
  lineTotalAmount Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}
